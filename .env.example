# ==============================================================================
# Chess Platform - Environment Configuration Template
# ==============================================================================

# Database Connection (PostgreSQL)
# Used by: packages/db, apps/backend, apps/ws
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chess?schema=public"

# Backend HTTP API Service (apps/backend)
PORT=3000
ALLOWED_HOSTS="http://localhost:5173"
COOKIE_SECRET="chess_platform_secret_cookie_key_2026"
JWT_SECRET="fk123456"
AUTH_REDIRECT_URL="http://localhost:5173/game/random"

# WebSocket Service (apps/ws)
WS_PORT=8080

# Frontend Web App (apps/frontend)
VITE_APP_BACKEND_URL="http://localhost:3000"
VITE_APP_WS_URL="ws://localhost:8080"

# Optional OAuth Providers (Guest login works out of the box without these)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
